{
  "name": "fuel-retail-inventory",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "lint": "npm run lint -w client",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "effect": "3.21.0"
  }
}